{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^wd-(.*)": "wot-design-uni/components/wd-$1/wd-$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/index/index",
      "style": {
        "navigationBarTitleText": "智练",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/review/index",
      "style": {
        "navigationBarTitleText": "学情概览",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/profile/index",
      "style": {
        "navigationBarTitleText": "个人中心"
      }
    },
    {
      "path": "pages/auth/login",
      "style": {
        "navigationBarTitleText": "登录智练"
      }
    }
  ],
  "tabBar": {
    "color": "#78716C",
    "selectedColor": "#1E3A8A",
    "backgroundColor": "#FFFFFF",
    "borderStyle": "white",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "工作台"
      },
      {
        "pagePath": "pages/review/index",
        "text": "学情"
      },
      {
        "pagePath": "pages/profile/index",
        "text": "我的"
      }
    ]
  },
  "subPackages": [
    {
      "root": "subpackages/material",
      "pages": [
        {
          "path": "pages/upload/index",
          "style": {
            "navigationBarTitleText": "导入资料"
          }
        },
        {
          "path": "pages/course/index",
          "style": {
            "navigationBarTitleText": "资料详情",
            "enablePullDownRefresh": true
          }
        },
        {
          "path": "pages/questions/index",
          "style": {
            "navigationBarTitleText": "核对出题"
          }
        }
      ]
    },
    {
      "root": "subpackages/practice",
      "pages": [
        {
          "path": "pages/session/index",
          "style": {
            "navigationBarTitleText": "练习作答",
            "disableScroll": false
          }
        }
      ]
    },
    {
      "root": "subpackages/report",
      "pages": [
        {
          "path": "pages/detail/index",
          "style": {
            "navigationBarTitleText": "诊断报告",
            "enablePullDownRefresh": true
          }
        }
      ]
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "智练",
    "navigationBarBackgroundColor": "#F7F5F0",
    "backgroundColor": "#F7F5F0"
  }
}
