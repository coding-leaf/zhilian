{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^wd-(.*)": "wot-design-uni/components/wd-$1/wd-$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/index/index",
      "style": {
        "navigationBarTitleText": "智练工作台"
      }
    },
    {
      "path": "pages/review/index",
      "style": {
        "navigationBarTitleText": "学情与错题",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/profile/index",
      "style": {
        "navigationBarTitleText": "我的与数据安全"
      }
    },
    {
      "path": "pages/auth/login",
      "style": {
        "navigationBarTitleText": "用户登录"
      }
    },
    {
      "path": "pages/login/index",
      "style": {
        "navigationBarTitleText": "用户登录"
      }
    }
  ],
  "tabBar": {
    "color": "#64748B",
    "selectedColor": "#2563EB",
    "backgroundColor": "#FFFFFF",
    "borderStyle": "white",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "学习",
        "iconPath": "static/tabbar/learn.png",
        "selectedIconPath": "static/tabbar/learn-active.png"
      },
      {
        "pagePath": "pages/review/index",
        "text": "学情与错题",
        "iconPath": "static/tabbar/review.png",
        "selectedIconPath": "static/tabbar/review-active.png"
      },
      {
        "pagePath": "pages/profile/index",
        "text": "我的",
        "iconPath": "static/tabbar/profile.png",
        "selectedIconPath": "static/tabbar/profile-active.png"
      }
    ]
  },
  "subPackages": [
    {
      "root": "subpackages/material",
      "pages": [
        {
          "path": "pages/upload/index",
          "style": {
            "navigationBarTitleText": "资料导入与质检"
          }
        },
        {
          "path": "pages/course/index",
          "style": {
            "navigationBarTitleText": "课程详情",
            "enablePullDownRefresh": true
          }
        },
        {
          "path": "pages/verify/index",
          "style": {
            "navigationBarTitleText": "题目质检核对清单"
          }
        },
        {
          "path": "pages/list/index",
          "style": {
            "navigationBarTitleText": "资料列表",
            "enablePullDownRefresh": true
          }
        },
        {
          "path": "pages/detail/index",
          "style": {
            "navigationBarTitleText": "资料详情"
          }
        },
        {
          "path": "pages/knowledge-tree/index",
          "style": {
            "navigationBarTitleText": "知识点树与出题配置"
          }
        },
        {
          "path": "pages/questions/index",
          "style": {
            "navigationBarTitleText": "题目列表"
          }
        },
        {
          "path": "index",
          "style": {
            "navigationBarTitleText": "资料管理"
          }
        }
      ]
    },
    {
      "root": "subpackages/practice",
      "pages": [
        {
          "path": "pages/session/index",
          "style": {
            "navigationBarTitleText": "练习作答"
          }
        },
        {
          "path": "pages/transition/index",
          "style": {
            "navigationBarTitleText": "诊断生成中"
          }
        }
      ]
    },
    {
      "root": "subpackages/report",
      "pages": [
        {
          "path": "pages/detail/index",
          "style": {
            "navigationBarTitleText": "学情诊断报告",
            "enablePullDownRefresh": true
          }
        },
        {
          "path": "pages/explanation/index",
          "style": {
            "navigationBarTitleText": "题目深度解析"
          }
        },
        {
          "path": "pages/wrong-book/index",
          "style": {
            "navigationBarTitleText": "错题本",
            "enablePullDownRefresh": true
          }
        },
        {
          "path": "index",
          "style": {
            "navigationBarTitleText": "学情诊断"
          }
        }
      ]
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "智练",
    "navigationBarBackgroundColor": "#F8FAFC",
    "backgroundColor": "#F8FAFC"
  }
}
