# 智练后端环境变量模板
#
# 用法：cp backend/.env.example backend/.env，按需填写。
# 所有变量统一前缀 ZHILIAN_，双下划线分隔配置段与字段（对应 app/core/config.py 的嵌套 Settings）。
#
# 零依赖起步：把各 provider 保持为 memory / fake，后端可在**不接任何外部服务**的情况下启动，
# 全量单元测试也正是在这一模式下运行（548 个测试函数不依赖数据库与网络）。
# 需要真实能力时，再把对应 provider 换成下面的生产取值。
# 密钥只放在 .env 与部署环境的密钥管理中：不进仓库、不进日志、不写进提交信息。

# ── 运行环境 ────────────────────────────────────────────────
ZHILIAN_ENV=development

# ── 数据库 ──────────────────────────────────────────────────
# 本机 compose 起的 PostgreSQL 16 + pgvector；检索需要 pgvector 扩展
ZHILIAN_DB__DB_URL=postgresql+asyncpg://zhilian_app:zhilian_secure_password_2026@localhost:5432/zhilian

# ── 队列与幂等（memory | redis）──────────────────────────────
ZHILIAN_REDIS__REDIS_URL=redis://localhost:6379/0
ZHILIAN_QUEUE__PROVIDER=memory
ZHILIAN_IDEMPOTENCY__PROVIDER=memory

# ── 对象存储（memory | s3 | minio）───────────────────────────
ZHILIAN_STORAGE__PROVIDER=memory
ZHILIAN_STORAGE__ENDPOINT_URL=http://localhost:9000
ZHILIAN_STORAGE__ACCESS_KEY=
ZHILIAN_STORAGE__SECRET_KEY=
ZHILIAN_STORAGE__BUCKET_NAME=zhilian

# ── 向量化（fake | openai | dashscope）──────────────────────
ZHILIAN_EMBEDDING__PROVIDER=fake
ZHILIAN_EMBEDDING__BASE_URL=
ZHILIAN_EMBEDDING__API_KEY=
ZHILIAN_EMBEDDING__MODEL=
ZHILIAN_EMBEDDING__DIMENSION=1024

# ── 混合检索（fake | pgvector）───────────────────────────────
ZHILIAN_SEARCH__PROVIDER=fake

# ── 大模型（fake | openai | dashscope | deepseek | siliconflow）──
# 出题、知识点抽取与主观题判题都依赖这一项；保持 fake 时这些链路返回模拟结果。
ZHILIAN_LLM__PROVIDER=fake
ZHILIAN_LLM__BASE_URL=
ZHILIAN_LLM__API_KEY=
ZHILIAN_LLM__MODEL=

# ── OCR（fake | tencent | baidu）─────────────────────────────
ZHILIAN_OCR__PROVIDER=fake
ZHILIAN_OCR__API_KEY=
ZHILIAN_OCR__SECRET_KEY=
ZHILIAN_OCR__ENDPOINT=
